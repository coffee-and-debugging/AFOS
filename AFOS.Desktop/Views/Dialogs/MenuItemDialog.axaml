<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AFOS.Desktop.Views.Dialogs.MenuItemDialog"
        Title="Menu Item"
        Height="480" Width="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Border Margin="28" Background="White" CornerRadius="10" Padding="28"
            BoxShadow="0 1 10 0 #12000000">
        <StackPanel Spacing="0">

            <TextBlock x:Name="TxtTitle" Text="Add Menu Item" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Name *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Classes="input" Margin="0,0,0,14"/>

            <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtDescription" Classes="input"
                     Height="70" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14"/>

            <TextBlock Text="Price (Rs.) *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPrice" Classes="input" Margin="0,0,0,14"/>

            <TextBlock Text="Category *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbCategory" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Tea"  Tag="tea"/>
                <ComboBoxItem Content="Food" Tag="food"/>
            </ComboBox>

            <CheckBox x:Name="ChkAvailable" Content="Available" IsChecked="True"
                      FontSize="13" Margin="0,0,0,18"/>

            <TextBlock x:Name="TxtError" FontSize="12" Foreground="#b91c1c"
                       Margin="0,0,0,10" IsVisible="False" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Cancel" Classes="secondary" Click="BtnCancel_Click"/>
                <Button Content="Save"   Classes="primary"   Click="BtnSave_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
