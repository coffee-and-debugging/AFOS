<Window x:Class="AFOS.Desktop.Views.Dialogs.OrderDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AFOS.Desktop.Converters"
        Title="Order Detail"
        Height="560" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter     x:Key="NullVis"/>
        <conv:BoolToVisibilityConverter     x:Key="BoolVis"/>
        <conv:StatusToBrushConverter        x:Key="StatusBg"/>
        <conv:StatusToFgConverter           x:Key="StatusFg"/>
        <conv:PayStatusToBrushConverter     x:Key="PayBg"/>
        <conv:PayStatusToFgConverter        x:Key="PayFg"/>
    </Window.Resources>

    <Border Margin="20" Background="White" CornerRadius="10" Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#000" Opacity="0.07" BlurRadius="10" ShadowDepth="1"/>
        </Border.Effect>
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="Bold">
                        <Run Text="Order #"/>
                        <Run x:Name="RunOrderId"/>
                    </TextBlock>
                    <TextBlock x:Name="TxtTableInfo" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border x:Name="StatusBadge" CornerRadius="12" Padding="10,4" Margin="0,0,0,4">
                        <TextBlock x:Name="TxtStatus" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="PayBadge" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="TxtPayment" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Separator Background="{StaticResource BorderColorBrush}" Margin="0,0,0,14"/>

            <!-- Items -->
            <TextBlock Text="Items" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="13">
                                    <Run Text="{Binding Quantity}" FontWeight="Bold"/>
                                    <Run Text="×  "/>
                                    <Run Text="{Binding Name}"/>
                                    <Run Text="  @ Rs." Foreground="#6c757d"/>
                                    <Run Text="{Binding Price, StringFormat={}{0:0.00}}" Foreground="#6c757d"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                           Text="{Binding Subtotal, StringFormat='Rs. {0:0.00}'}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Separator Background="{StaticResource BorderColorBrush}" Margin="0,10"/>

            <!-- Customer note -->
            <Border x:Name="NoteBox" Background="{StaticResource WarningBgBrush}"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,10"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtNote" FontSize="12"
                           Foreground="{StaticResource WarningTextBrush}"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Total -->
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Total" FontSize="14" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" x:Name="TxtTotal"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </Grid>

            <!-- Date -->
            <TextBlock x:Name="TxtDate" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

            <!-- Status change -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Change Status:"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbStatus" Grid.Column="1"
                          Style="{StaticResource ComboStyle}"
                          Width="160" SelectionChanged="CmbStatus_SelectionChanged">
                    <ComboBoxItem Content="Pending"   Tag="pending"/>
                    <ComboBoxItem Content="Cooking"   Tag="cooking"/>
                    <ComboBoxItem Content="Serving"   Tag="serving"/>
                    <ComboBoxItem Content="Completed" Tag="completed"/>
                </ComboBox>
            </Grid>

            <!-- Confirm Cash -->
            <Button x:Name="BtnConfirmCash"
                    Content="✓  Confirm Cash Payment"
                    Style="{StaticResource BtnWarning}"
                    HorizontalAlignment="Stretch" Height="36"
                    Margin="0,0,0,14" Visibility="Collapsed"
                    Click="BtnConfirmCash_Click"/>

            <!-- Close -->
            <Button Content="Close" Style="{StaticResource BtnSecondary}"
                    HorizontalAlignment="Right" Click="BtnClose_Click"/>

        </StackPanel>
    </Border>
</Window>
