<Window x:Class="AFOS.Desktop.Views.Dialogs.MenuItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menu Item"
        Height="480" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Border Margin="28" Background="White" CornerRadius="10" Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#000" Opacity="0.07" BlurRadius="10" ShadowDepth="1"/>
        </Border.Effect>
        <StackPanel>

            <TextBlock x:Name="TxtTitle" Text="Add Menu Item" FontSize="18"
                       FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Name -->
            <TextBlock Text="Name *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtName" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

            <!-- Description -->
            <TextBlock Text="Description" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtDescription" Style="{StaticResource InputBox}"
                     Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,14"/>

            <!-- Price -->
            <TextBlock Text="Price (Rs.) *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPrice" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

            <!-- Category -->
            <TextBlock Text="Category *" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbCategory" Style="{StaticResource ComboStyle}"
                      Margin="0,0,0,14">
                <ComboBoxItem Content="Tea"  Tag="tea"/>
                <ComboBoxItem Content="Food" Tag="food"/>
            </ComboBox>

            <!-- Available -->
            <CheckBox x:Name="ChkAvailable" Content="Available" IsChecked="True"
                      FontSize="13" Margin="0,0,0,18"/>

            <!-- Error -->
            <TextBlock x:Name="TxtError" FontSize="12" Foreground="#b91c1c"
                       Margin="0,0,0,10" Visibility="Collapsed" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource BtnSecondary}"
                        Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="Save" Style="{StaticResource BtnPrimary}"
                        Click="BtnSave_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
