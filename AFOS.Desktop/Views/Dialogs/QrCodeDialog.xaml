<Window x:Class="AFOS.Desktop.Views.Dialogs.QrCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR Code"
        Height="440" Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Border Margin="24" Background="White" CornerRadius="10" Padding="28">
        <Border.Effect>
            <DropShadowEffect Color="#000" Opacity="0.07" BlurRadius="10" ShadowDepth="1"/>
        </Border.Effect>
        <StackPanel HorizontalAlignment="Center">

            <TextBlock x:Name="TxtTitle" FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtUrl" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,16"
                       TextWrapping="Wrap" TextAlignment="Center"/>

            <!-- QR Image -->
            <Border BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,16"
                    HorizontalAlignment="Center">
                <Image x:Name="QrImage" Width="260" Height="260"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Download PNG"
                        Style="{StaticResource BtnPrimary}"
                        Margin="0,0,10,0"
                        Click="BtnDownload_Click"/>
                <Button Content="Close"
                        Style="{StaticResource BtnSecondary}"
                        Click="BtnClose_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
