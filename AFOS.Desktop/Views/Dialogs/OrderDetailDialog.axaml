<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AFOS.Desktop.Views.Dialogs.OrderDetailDialog"
        Title="Order Detail"
        Height="560" Width="480"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">

    <Border Margin="20" Background="White" CornerRadius="10" Padding="28"
            BoxShadow="0 1 10 0 #12000000">
        <StackPanel Spacing="0">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtOrderTitle" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTableInfo" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <Border x:Name="StatusBadge" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="TxtStatus" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border x:Name="PayBadge" CornerRadius="12" Padding="10,4">
                        <TextBlock x:Name="TxtPayment" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BorderColorBrush}" Height="1" Margin="0,0,0,14"/>

            <!-- Items -->
            <TextBlock Text="Items" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <ScrollViewer MaxHeight="180">
                <ItemsControl x:Name="ItemsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                <TextBlock Grid.Column="0" FontSize="13">
                                    <Run Text="{Binding Quantity}" FontWeight="Bold"/>
                                    <Run Text="×  "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>
                                <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold"
                                           Text="{Binding Subtotal, StringFormat='Rs. {0:0.00}'}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="{StaticResource BorderColorBrush}" Height="1" Margin="0,10"/>

            <!-- Note -->
            <Border x:Name="NoteBox" Background="{StaticResource WarningBgBrush}"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,10" IsVisible="False">
                <TextBlock x:Name="TxtNote" FontSize="12"
                           Foreground="{StaticResource WarningTextBrush}" TextWrapping="Wrap"/>
            </Border>

            <!-- Total -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <TextBlock Grid.Column="0" Text="Total" FontSize="14" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" x:Name="TxtTotal" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
            </Grid>

            <TextBlock x:Name="TxtDate" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,16"/>

            <!-- Status change -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <TextBlock Grid.Column="0" Text="Change Status:" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbStatus" Grid.Column="1" Width="160"
                          SelectionChanged="CmbStatus_SelectionChanged">
                    <ComboBoxItem Content="Pending"   Tag="pending"/>
                    <ComboBoxItem Content="Cooking"   Tag="cooking"/>
                    <ComboBoxItem Content="Serving"   Tag="serving"/>
                    <ComboBoxItem Content="Completed" Tag="completed"/>
                </ComboBox>
            </Grid>

            <!-- Confirm Cash -->
            <Button x:Name="BtnConfirmCash" Content="✓  Confirm Cash Payment"
                    Classes="warning" HorizontalAlignment="Stretch" Height="36"
                    Margin="0,0,0,14" IsVisible="False"
                    Click="BtnConfirmCash_Click"/>

            <Button Content="Close" Classes="secondary"
                    HorizontalAlignment="Right" Click="BtnClose_Click"/>

        </StackPanel>
    </Border>
</Window>
