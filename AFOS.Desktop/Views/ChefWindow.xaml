<Window x:Class="AFOS.Desktop.Views.ChefWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AFOS.Desktop.Converters"
        Title="AFOS Chef Station"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter        x:Key="BoolVis"/>
        <conv:NullToVisibilityConverter        x:Key="NullVis"/>
        <conv:StatusToBrushConverter           x:Key="StatusBg"/>
        <conv:StatusToFgConverter              x:Key="StatusFg"/>
        <conv:PayStatusToBrushConverter        x:Key="PayBg"/>
        <conv:PayStatusToFgConverter           x:Key="PayFg"/>
        <conv:StatusToBorderBrushConverter     x:Key="StatusBorder"/>
    </Window.Resources>

    <DockPanel>

        <!-- ── Top Bar ─────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="24,0">
            <Grid Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="👨‍🍳" FontSize="22" Margin="0,0,10,0"/>
                    <TextBlock Text="Chef Station" FontSize="18" FontWeight="Bold"
                               Foreground="White"/>
                    <!-- New badge -->
                    <Border Background="#fd7e14" CornerRadius="12" Padding="8,2"
                            Margin="12,0,0,0"
                            Visibility="{Binding HasNewOrders, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding NewBadge}" FontSize="11"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Welcome -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="#c8d8c4">
                        <Run Text="Welcome, "/>
                        <Run Text="{Binding WelcomeName}" FontWeight="SemiBold" Foreground="White"/>
                    </TextBlock>
                </StackPanel>

                <!-- Logout -->
                <Button Grid.Column="2" Content="Logout"
                        Style="{StaticResource BtnSecondary}"
                        Padding="14,6" FontSize="12"
                        Click="BtnLogout_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Stats Row ───────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="White" Padding="20,12"
                BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Pending -->
                <Border Background="#fff3cd" CornerRadius="8" Padding="20,10" Margin="6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Pending}" FontSize="24" FontWeight="Bold"
                                   Foreground="#856404" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pending" FontSize="11" Foreground="#856404"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Cooking -->
                <Border Background="#cff4fc" CornerRadius="8" Padding="20,10" Margin="6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Cooking}" FontSize="24" FontWeight="Bold"
                                   Foreground="#055160" HorizontalAlignment="Center"/>
                        <TextBlock Text="Cooking" FontSize="11" Foreground="#055160"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Serving -->
                <Border Background="#d1e7dd" CornerRadius="8" Padding="20,10" Margin="6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Serving}" FontSize="24" FontWeight="Bold"
                                   Foreground="#0a3622" HorizontalAlignment="Center"/>
                        <TextBlock Text="Serving" FontSize="11" Foreground="#0a3622"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- Completed -->
                <Border Background="#e2e3e5" CornerRadius="8" Padding="20,10" Margin="6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Completed}" FontSize="24" FontWeight="Bold"
                                   Foreground="#41464b" HorizontalAlignment="Center"/>
                        <TextBlock Text="Completed" FontSize="11" Foreground="#41464b"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── Filter Tabs ─────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="White" Padding="20,0"
                BorderBrush="{StaticResource BorderColorBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnFilterActive"    Content="Active"    Tag="active"
                        Click="FilterBtn_Click" Style="{StaticResource NavBtn}"
                        Foreground="{StaticResource PrimaryBrush}" Padding="18,12"/>
                <Button x:Name="BtnFilterServing"   Content="Serving"   Tag="serving"
                        Click="FilterBtn_Click" Style="{StaticResource NavBtn}"
                        Foreground="{StaticResource TextMutedBrush}" Padding="18,12"/>
                <Button x:Name="BtnFilterCompleted" Content="Completed" Tag="completed"
                        Click="FilterBtn_Click" Style="{StaticResource NavBtn}"
                        Foreground="{StaticResource TextMutedBrush}" Padding="18,12"/>
                <Button x:Name="BtnFilterAll"       Content="All"       Tag="all"
                        Click="FilterBtn_Click" Style="{StaticResource NavBtn}"
                        Foreground="{StaticResource TextMutedBrush}" Padding="18,12"/>
            </StackPanel>
        </Border>

        <!-- ── Order Cards ─────────────────────────────────────────────── -->
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto" Padding="16,16">
            <ItemsControl ItemsSource="{Binding FilteredOrders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Order Card -->
                        <Border Margin="8" Width="320" VerticalAlignment="Top"
                                Background="White" CornerRadius="10"
                                BorderThickness="3,0,0,0"
                                BorderBrush="{Binding Status, Converter={StaticResource StatusBorder}}">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" Opacity="0.06" BlurRadius="8" ShadowDepth="1"/>
                            </Border.Effect>
                            <StackPanel Margin="14,12">

                                <!-- Card header -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontSize="15" FontWeight="Bold">
                                            <Run Text="Table #"/>
                                            <Run Text="{Binding TableNumber}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding ShortId}" FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <Border Background="{Binding Status, Converter={StaticResource StatusBg}}"
                                                CornerRadius="12" Padding="8,3">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                        </Border>
                                        <TextBlock Text="{Binding TimeAgo}" FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{StaticResource BorderColorBrush}" Margin="0,4,0,8"/>

                                <!-- Items list -->
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontSize="12">
                                                    <Run Text="{Binding Quantity}" FontWeight="Bold"/>
                                                    <Run Text="×"/>
                                                    <Run Text="{Binding Name}"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" FontSize="12"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Text="{Binding Subtotal, StringFormat='Rs. {0:0.00}'}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Customer note -->
                                <Border Background="{StaticResource WarningBgBrush}"
                                        CornerRadius="6" Padding="10,6" Margin="0,0,0,8"
                                        Visibility="{Binding CustomerNote, Converter={StaticResource NullVis}}">
                                    <TextBlock Text="{Binding CustomerNote}" FontSize="12"
                                               Foreground="{StaticResource WarningTextBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <!-- Total + payment -->
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="13" FontWeight="Bold"
                                               Text="{Binding TotalDisplay}"/>
                                    <Border Grid.Column="1"
                                            Background="{Binding PaymentStatus, Converter={StaticResource PayBg}}"
                                            CornerRadius="10" Padding="8,2">
                                        <TextBlock Text="{Binding PaymentStatusDisplay}" FontSize="11"
                                                   Foreground="{Binding PaymentStatus, Converter={StaticResource PayFg}}"/>
                                    </Border>
                                </Grid>

                                <!-- Action button -->
                                <Button Tag="{Binding}"
                                        Content="{Binding NextActionLabel}"
                                        IsEnabled="{Binding CanAdvance}"
                                        Click="BtnAdvance_Click"
                                        Style="{StaticResource BtnPrimary}"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,9"
                                        FontSize="13"/>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
