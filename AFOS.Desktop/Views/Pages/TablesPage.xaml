<UserControl x:Class="AFOS.Desktop.Views.Pages.TablesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AFOS.Desktop.Converters"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Tables &amp; QR Codes" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Manage tables and generate QR codes for customers"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <!-- Add Table Card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Add New Table" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtTableNumber"
                                 Style="{StaticResource InputBox}"
                                 Text="{Binding NewTableNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Width="160" Margin="0,0,10,0"
                                 KeyDown="TxtTableNumber_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border" BasedOn="{StaticResource {x:Type Border}}"/>
                            </TextBox.Resources>
                        </TextBox>
                        <Button Content="Add Table"
                                Style="{StaticResource BtnPrimary}"
                                Click="BtnAddTable_Click"/>
                    </StackPanel>
                    <!-- Error -->
                    <TextBlock x:Name="TxtAddError" FontSize="12" Foreground="#b91c1c"
                               Margin="0,8,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <TextBlock Text="Loading..." FontSize="14"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,10"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

            <!-- Tables list -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="All Tables" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <!-- Empty state -->
                    <TextBlock Text="No tables added yet. Add your first table above."
                               FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,20"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

                    <DataGrid ItemsSource="{Binding Tables}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserResizeRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" AlternatingRowBackground="#f9fafb"
                              RowBackground="White" FontSize="12"
                              BorderThickness="1" BorderBrush="{StaticResource BorderColorBrush}"
                              RowHeight="44" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Table #"      Binding="{Binding Number}"      Width="100"/>
                            <DataGridTextColumn Header="ID"           Binding="{Binding Id}"          Width="180"/>
                            <DataGridTextColumn Header="Customer URL" Binding="{Binding CustomerUrl}" Width="*"/>
                            <DataGridTemplateColumn Header="Actions"  Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,4">
                                            <Button Content="QR Code" Tag="{Binding}"
                                                    Click="BtnQr_Click"
                                                    Style="{StaticResource BtnPrimary}"
                                                    Padding="12,5" FontSize="11"
                                                    Margin="0,0,6,0"/>
                                            <Button Content="Remove" Tag="{Binding}"
                                                    Click="BtnRemove_Click"
                                                    Style="{StaticResource BtnDanger}"
                                                    Padding="12,5" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
