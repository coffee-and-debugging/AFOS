<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AFOS.Desktop.Converters"
             x:Class="AFOS.Desktop.Views.Pages.TablesPage">

    <UserControl.Resources>
        <conv:BoolToIsVisibleConverter x:Key="BoolVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24">
        <StackPanel Spacing="20">

            <!-- Header -->
            <TextBlock Text="Tables &amp; QR Codes" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}"/>

            <!-- Add Table Card -->
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Add New Table" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="TxtTableNumber" Classes="input"
                                 Width="180"
                                 Watermark="Table number"
                                 Text="{Binding NewTableNumber, Mode=TwoWay}"
                                 KeyDown="TxtTableNumber_KeyDown"/>
                        <Button Content="Add Table" Classes="primary"
                                Click="BtnAddTable_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtAddError"
                               IsVisible="False"
                               Foreground="#b91c1c" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Loading -->
            <TextBlock Text="Loading tables..." FontSize="13"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

            <!-- Tables DataGrid -->
            <Border Classes="card">
                <DataGrid ItemsSource="{Binding Tables}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="1"
                          BorderBrush="{StaticResource BorderColorBrush}"
                          CornerRadius="6">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Table #" Binding="{Binding Number}" Width="100"/>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="*"/>
                        <DataGridTextColumn Header="Customer URL" Binding="{Binding CustomerUrl}" Width="1.5*"/>
                        <DataGridTemplateColumn Header="Actions" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="QR Code" Classes="primary"
                                                Tag="{Binding}" Click="BtnQr_Click"/>
                                        <Button Content="Remove" Classes="danger"
                                                Tag="{Binding}" Click="BtnRemove_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
