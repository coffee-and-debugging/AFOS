<UserControl x:Class="AFOS.Desktop.Views.Pages.MenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AFOS.Desktop.Converters"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter  x:Key="BoolVis"/>
        <conv:NullToVisibilityConverter  x:Key="NullVis"/>
        <conv:AvailableToTextConverter   x:Key="AvailText"/>
        <conv:AvailableToFgConverter     x:Key="AvailFg"/>
        <conv:AvailableToBgConverter     x:Key="AvailBg"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Menu Management" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Manage tea and food menu items"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Add Item"
                        Style="{StaticResource BtnPrimary}"
                        Click="BtnAddItem_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- Status message -->
            <Border Background="#fef2f2" CornerRadius="6" Padding="12,8" Margin="0,0,0,14"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#b91c1c" FontSize="12"/>
            </Border>

            <!-- Loading -->
            <TextBlock Text="Loading..." FontSize="14"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center" Margin="0,20"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

            <!-- ── Tea Items ── -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="{StaticResource PrimaryPaleBrush}"
                                CornerRadius="6" Padding="10,4">
                            <TextBlock Text="🍵  Teas" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding TeaItems}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserResizeRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" AlternatingRowBackground="#f9fafb"
                              RowBackground="White" FontSize="12"
                              BorderThickness="1" BorderBrush="{StaticResource BorderColorBrush}"
                              RowHeight="44" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"        Binding="{Binding Name}"        Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Price"       Binding="{Binding PriceDisplay}" Width="90"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Available, Converter={StaticResource AvailBg}}"
                                                CornerRadius="10" Padding="8,3" Margin="4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Available, Converter={StaticResource AvailText}}"
                                                       FontSize="11"
                                                       Foreground="{Binding Available, Converter={StaticResource AvailFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,4">
                                            <Button Content="Edit"   Tag="{Binding}" Click="BtnEdit_Click"
                                                    Style="{StaticResource BtnSmall}" Margin="0,0,4,0"/>
                                            <Button Content="Toggle" Tag="{Binding}" Click="BtnToggle_Click"
                                                    Style="{StaticResource BtnSecondary}"
                                                    Padding="10,5" FontSize="11" Margin="0,0,4,0"/>
                                            <Button Content="Delete" Tag="{Binding}" Click="BtnDelete_Click"
                                                    Style="{StaticResource BtnDanger}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- ── Food Items ── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Background="{StaticResource PrimaryPaleBrush}"
                                CornerRadius="6" Padding="10,4">
                            <TextBlock Text="🍽  Food" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding FoodItems}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserResizeRows="False" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" AlternatingRowBackground="#f9fafb"
                              RowBackground="White" FontSize="12"
                              BorderThickness="1" BorderBrush="{StaticResource BorderColorBrush}"
                              RowHeight="44" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"        Binding="{Binding Name}"        Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Price"       Binding="{Binding PriceDisplay}" Width="90"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Available, Converter={StaticResource AvailBg}}"
                                                CornerRadius="10" Padding="8,3" Margin="4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Available, Converter={StaticResource AvailText}}"
                                                       FontSize="11"
                                                       Foreground="{Binding Available, Converter={StaticResource AvailFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="230">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,4">
                                            <Button Content="Edit"   Tag="{Binding}" Click="BtnEdit_Click"
                                                    Style="{StaticResource BtnSmall}" Margin="0,0,4,0"/>
                                            <Button Content="Toggle" Tag="{Binding}" Click="BtnToggle_Click"
                                                    Style="{StaticResource BtnSecondary}"
                                                    Padding="10,5" FontSize="11" Margin="0,0,4,0"/>
                                            <Button Content="Delete" Tag="{Binding}" Click="BtnDelete_Click"
                                                    Style="{StaticResource BtnDanger}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
