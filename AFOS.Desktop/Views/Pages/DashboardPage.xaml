<UserControl x:Class="AFOS.Desktop.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AFOS.Desktop.Converters"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:StatusToBrushConverter   x:Key="StatusBg"/>
        <conv:StatusToFgConverter      x:Key="StatusFg"/>
        <conv:PayStatusToBrushConverter x:Key="PayBg"/>
        <conv:PayStatusToFgConverter    x:Key="PayFg"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,28">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LastUpdated}" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻  Refresh"
                        Style="{StaticResource BtnSecondary}"
                        Click="BtnRefresh_Click" VerticalAlignment="Center"/>
            </Grid>

            <!-- ── Stat Cards ── -->
            <UniformGrid Columns="3" Margin="0,0,0,20">
                <!-- Total Orders -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,10">
                    <StackPanel>
                        <TextBlock Text="Total Orders" FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalOrders}" FontSize="30"
                                   FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Pending -->
                <Border Style="{StaticResource Card}" Margin="5,0,5,10"
                        BorderBrush="#fd7e14" BorderThickness="0,3,0,0">
                    <StackPanel>
                        <TextBlock Text="Pending" FontSize="12" Foreground="#856404"/>
                        <TextBlock Text="{Binding Pending}" FontSize="30"
                                   FontWeight="Bold" Foreground="#856404" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Cooking -->
                <Border Style="{StaticResource Card}" Margin="10,0,0,10"
                        BorderBrush="#0dcaf0" BorderThickness="0,3,0,0">
                    <StackPanel>
                        <TextBlock Text="Cooking" FontSize="12" Foreground="#055160"/>
                        <TextBlock Text="{Binding Cooking}" FontSize="30"
                                   FontWeight="Bold" Foreground="#055160" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Serving -->
                <Border Style="{StaticResource Card}" Margin="0,0,10,0"
                        BorderBrush="#2d6a4f" BorderThickness="0,3,0,0">
                    <StackPanel>
                        <TextBlock Text="Serving" FontSize="12" Foreground="#0a3622"/>
                        <TextBlock Text="{Binding Serving}" FontSize="30"
                                   FontWeight="Bold" Foreground="#0a3622" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Revenue -->
                <Border Style="{StaticResource Card}" Margin="5,0,5,0"
                        BorderBrush="#2d6a4f" BorderThickness="0,3,0,0">
                    <StackPanel>
                        <TextBlock Text="Revenue Collected" FontSize="12" Foreground="#0a3622"/>
                        <TextBlock Text="{Binding RevenueDisplay}" FontSize="22"
                                   FontWeight="Bold" Foreground="#2d6a4f" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Cash Pending -->
                <Border Style="{StaticResource Card}" Margin="10,0,0,0"
                        BorderBrush="#fd7e14" BorderThickness="0,3,0,0"
                        Visibility="{Binding HasCashPending, Converter={StaticResource BoolVis}}">
                    <StackPanel>
                        <TextBlock Text="Cash Pending" FontSize="12" Foreground="#856404"/>
                        <TextBlock Text="{Binding CashPendingDisplay}" FontSize="22"
                                   FontWeight="Bold" Foreground="#fd7e14" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ── Charts Row ── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Orders by Status -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Orders by Status" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>
                        <Grid Height="170">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Bars -->
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding StatusChartData}"
                                          VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="55" Margin="6,0"
                                                    VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding DisplayValue}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <Rectangle Height="{Binding BarHeight}"
                                                       Fill="{Binding BarBrush}"
                                                       RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Stretch"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Labels -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding StatusChartData}"
                                          Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Width="55"
                                                   Margin="6,0" TextAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Payment Breakdown (Pie-style) -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0">
                    <StackPanel>
                        <TextBlock Text="Payment" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Paid -->
                            <Border Background="#d1e7dd" CornerRadius="8"
                                    Padding="16,10" Margin="0,0,0,10" Width="140">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PaidCount}" FontSize="28"
                                               FontWeight="Bold" Foreground="#0a3622"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Paid" FontSize="12" Foreground="#0a3622"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <!-- Unpaid -->
                            <Border Background="#f8d7da" CornerRadius="8"
                                    Padding="16,10" Width="140">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding UnpaidCount}" FontSize="28"
                                               FontWeight="Bold" Foreground="#842029"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Unpaid" FontSize="12" Foreground="#842029"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Revenue by Method -->
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Revenue by Method" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,14"/>
                        <Grid Height="170">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ItemsControl Grid.Row="0" ItemsSource="{Binding RevenueChartData}"
                                          VerticalAlignment="Bottom">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="70" Margin="6,0"
                                                    VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding DisplayRs}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" TextAlignment="Center"/>
                                            <Rectangle Height="{Binding BarHeight}"
                                                       Fill="{Binding BarBrush}"
                                                       RadiusX="3" RadiusY="3"
                                                       HorizontalAlignment="Stretch"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding RevenueChartData}"
                                          Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Width="70"
                                                   Margin="6,0" TextAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Orders Table ── -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- Table header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Orders" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <!-- Filter buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnAll"       Content="All"       Tag="all"       Click="FilterBtn_Click" Style="{StaticResource BtnPrimary}"  Margin="3,0" Padding="12,6" FontSize="11"/>
                            <Button x:Name="BtnPending"   Content="Pending"   Tag="pending"   Click="FilterBtn_Click" Style="{StaticResource BtnSecondary}" Margin="3,0" Padding="12,6" FontSize="11"/>
                            <Button x:Name="BtnCooking"   Content="Cooking"   Tag="cooking"   Click="FilterBtn_Click" Style="{StaticResource BtnSecondary}" Margin="3,0" Padding="12,6" FontSize="11"/>
                            <Button x:Name="BtnServing"   Content="Serving"   Tag="serving"   Click="FilterBtn_Click" Style="{StaticResource BtnSecondary}" Margin="3,0" Padding="12,6" FontSize="11"/>
                            <Button x:Name="BtnCompleted" Content="Completed" Tag="completed" Click="FilterBtn_Click" Style="{StaticResource BtnSecondary}" Margin="3,0" Padding="12,6" FontSize="11"/>
                        </StackPanel>
                    </Grid>

                    <!-- Table -->
                    <DataGrid x:Name="OrdersGrid"
                              ItemsSource="{Binding FilteredOrders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserResizeRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#f9fafb"
                              RowBackground="White"
                              FontSize="12"
                              BorderThickness="1"
                              BorderBrush="{StaticResource BorderColorBrush}"
                              RowHeight="40"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Table #"   Binding="{Binding TableNumber}" Width="70"/>
                            <DataGridTextColumn Header="Items"     Binding="{Binding ItemsDisplay}" Width="80"/>
                            <DataGridTextColumn Header="Total"     Binding="{Binding TotalDisplay}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Status, Converter={StaticResource StatusBg}}"
                                                CornerRadius="10" Padding="8,3" Margin="4,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Payment" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding PaymentStatus, Converter={StaticResource PayBg}}"
                                                CornerRadius="10" Padding="8,3" Margin="4,4"
                                                HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding PaymentStatusDisplay}" FontSize="11"
                                                       Foreground="{Binding PaymentStatus, Converter={StaticResource PayFg}}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Date/Time" Binding="{Binding TimeDisplay}" Width="140"/>
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,4">
                                            <Button Content="View" Tag="{Binding}"
                                                    Style="{StaticResource BtnSmall}"
                                                    Click="BtnView_Click" Margin="0,0,4,0"/>
                                            <Button Content="Confirm Cash"
                                                    Tag="{Binding}"
                                                    Style="{StaticResource BtnWarning}"
                                                    Click="BtnConfirmCash_Click"
                                                    Visibility="{Binding CanConfirmCash, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
