<Window x:Class="AFOS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AFOS.Desktop.Converters"
        Title="AFOS — Login"
        Height="520" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolVis"/>
        <conv:NullToVisibilityConverter x:Key="NullVis"/>
    </Window.Resources>

    <Grid>
        <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="360"
                Background="White" CornerRadius="14"
                Padding="40,36">
            <Border.Effect>
                <DropShadowEffect Color="#000" Opacity="0.10" BlurRadius="20" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>

                <!-- Logo / brand -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="50" Width="60" Height="60"
                            HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🍵" FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AFOS" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Tea Shop Management" FontSize="13"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="TxtUsername"
                         Style="{StaticResource InputBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="Input_KeyDown"/>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold"
                           Margin="0,14,0,5"/>
                <PasswordBox x:Name="PwdPassword"
                             Style="{StaticResource PwdBox}"
                             KeyDown="Input_KeyDown"/>

                <!-- Error -->
                <Border Background="#fef2f2" CornerRadius="6" Padding="12,8"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#b91c1c" FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Login button -->
                <Button x:Name="BtnLogin"
                        Content="Login"
                        Style="{StaticResource BtnPrimary}"
                        Margin="0,18,0,0"
                        Height="40" FontSize="14"
                        IsEnabled="{Binding IsNotLoading}"
                        Click="BtnLogin_Click"/>

                <!-- Loading indicator -->
                <TextBlock Text="Authenticating..."
                           HorizontalAlignment="Center" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,10,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolVis}}"/>

                <!-- Footer -->
                <TextBlock Text="Admin or Chef login only"
                           HorizontalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
