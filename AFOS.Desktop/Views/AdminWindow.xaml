<Window x:Class="AFOS.Desktop.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AFOS Admin"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar ──────────────────────────────────────── -->
        <DockPanel Grid.Column="0" Background="{StaticResource SidebarBrush}">

            <!-- Brand -->
            <StackPanel DockPanel.Dock="Top" Margin="0,28,0,24" HorizontalAlignment="Center">
                <Border Background="#2d6a4f" CornerRadius="40"
                        Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="🍵" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="AFOS" FontSize="18" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Admin Portal" FontSize="11"
                           Foreground="#7fada0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Bottom user info + logout -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16">
                <Separator Background="#2d6a4f" Margin="16,8"/>
                <TextBlock x:Name="TxtUserName" FontSize="12" FontWeight="SemiBold"
                           Foreground="#c8d8c4" Margin="22,0,0,2"/>
                <TextBlock Text="Administrator" FontSize="11"
                           Foreground="#7fada0" Margin="22,0,0,0"/>
                <Button Content="Logout" Style="{StaticResource NavBtn}"
                        Foreground="#f87171" Margin="0,10,0,0"
                        Click="BtnLogout_Click"/>
            </StackPanel>

            <!-- Nav buttons -->
            <StackPanel DockPanel.Dock="Top">
                <Button x:Name="BtnNavDashboard"
                        Style="{StaticResource NavBtnActive}"
                        Click="NavDashboard_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Dashboard"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNavMenu"
                        Style="{StaticResource NavBtn}"
                        Click="NavMenu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🍽" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Menu Management"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNavTables"
                        Style="{StaticResource NavBtn}"
                        Click="NavTables_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🪑" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock Text="Tables &amp; QR Codes"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </DockPanel>

        <!-- ── Main Content ──────────────────────────────────── -->
        <ContentControl x:Name="MainContent" Grid.Column="1"
                        Background="{StaticResource BgBrush}"/>

    </Grid>
</Window>
