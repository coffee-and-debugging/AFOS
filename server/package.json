{
  "name": "server",
  "version": "1.2.0",
  "description": "AFOS restaurant management API",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/prisma.js generate",
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:migrate": "node scripts/prisma.js migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:status": "node scripts/prisma.js migrate status",
    "db:demo": "node prisma/demo.js",
    "plan": "node scripts/set-plan.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "express",
    "orders",
    "qr"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
