generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  username     String?        @unique // null for payroll-only staff who never sign in
  password     String?
  role         String // admin | cashier | chef | staff (payroll only, no app access)
  name         String
  position     String         @default("") // job title shown in the directory, e.g. "Head chef", "Waiter"
  categoryId   Int? // department, e.g. Kitchen, Service, Housekeeping
  category     StaffCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  phone        String         @default("")
  active       Boolean        @default(true) // deactivated staff cannot sign in and drop off payroll
  baseSalary   Float          @default(0) // monthly
  overtimeRate Float          @default(0) // per overtime hour
  joinedAt     DateTime       @default(now())
  createdAt    DateTime       @default(now())
  payments     StaffPayment[]

  @@index([categoryId])
}

// Department/team staff are grouped by. Managers can add their own as the team grows.
model StaffCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String   @default("")
  color       String   @default("gray") // red | orange | amber | green | blue | purple | gray
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  staff       User[]
}

// One payout to a staff member: salary for a period plus bonus/overtime, minus deductions.
model StaffPayment {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  period         String // YYYY-MM the payment covers
  baseAmount     Float    @default(0)
  bonus          Float    @default(0)
  overtimeHours  Float    @default(0)
  overtimeRate   Float    @default(0)
  overtimeAmount Float    @default(0)
  deductions     Float    @default(0)
  netAmount      Float
  method         String   @default("cash") // cash | bank | esewa | khalti
  note           String   @default("")
  paidAt         DateTime @default(now())
  recordedBy     String   @default("")
  createdAt      DateTime @default(now())

  @@index([userId, period])
  @@index([paidAt])
}

// Single-row table (id = 1) holding the restaurant's details and billing rules.
model Restaurant {
  id                Int      @id @default(1)
  name              String
  tagline           String   @default("")
  currency          String   @default("Rs.")
  address           String   @default("")
  phone             String   @default("")
  taxRate           Float    @default(13)
  serviceChargeRate Float    @default(10)
  receiptFooter     String   @default("Thank you for dining with us!")
  qrBaseUrl         String   @default("") // address printed in table QR codes, e.g. http://192.168.100.20:5173; empty = auto
  plan              String   @default("free") // free | pro — gates premium features (see lib/plans.js)
  updatedAt         DateTime @updatedAt
}

model Category {
  id        Int        @id @default(autoincrement())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  items     MenuItem[]
}

model MenuItem {
  id          Int          @id @default(autoincrement())
  name        String
  description String       @default("")
  ingredients String       @default("") // optional, display only (shown to guests); not tied to inventory
  price       Float
  halfPrice   Float? // optional half-plate price; when set, guests and the POS can order a half plate
  category    String
  categoryRef Category     @relation(fields: [category], references: [slug], onUpdate: Cascade, onDelete: Restrict)
  available   Boolean      @default(true)
  imageUrl    String?
  recipe      RecipeItem[]

  @@index([category])
}

// Optional inventory link: quantities consumed per unit of a menu item, deducted from inventory when ordered
// (e.g. menu "Water bottle" → 1 pcs of inventory "Water bottle"). Menu items without links are not tracked.
model RecipeItem {
  menuItemId  Int
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  stockItemId Int
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantity    Float

  @@id([menuItemId, stockItemId])
}

model Table {
  id     String  @id // random permanent token (lib/ids.js), part of the table's QR URL
  number Int     @unique
  orders Order[]
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String?  @unique
  email     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id            String      @id @default(uuid())
  billNo        Int         @unique @default(autoincrement())
  type          String      @default("dine_in") // dine_in | takeaway
  source        String      @default("qr") // qr | pos
  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id])
  tableNumber   Int?
  customerId    String?
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  customerNote  String      @default("")
  status        String      @default("pending") // pending | cooking | serving | completed | cancelled
  paymentStatus String      @default("unpaid") // unpaid | pending_counter | paid
  paymentMethod String? // cash | card | esewa | khalti | counter
  paymentRef    String? // gateway transaction id for eSewa/Khalti payments
  subtotal      Float       @default(0)
  discount      Float       @default(0)
  serviceCharge Float       @default(0)
  tax           Float       @default(0)
  totalAmount   Float
  paidAt        DateTime?
  payments      PaymentAttempt[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
}

// One online checkout started by a guest. The order is only marked paid after the
// gateway itself confirms the transaction (server-to-server), never on the browser's word.
model PaymentAttempt {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway      String // esewa | khalti
  reference    String   @unique // eSewa transaction_uuid / Khalti pidx
  amount       Float
  status       String   @default("initiated") // initiated | completed | failed
  gatewayTxnId String? // eSewa ref_id / Khalti transaction_id
  response     Json? // last answer from the gateway, for reconciliation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
}

model OrderItem {
  id         String @id @default(uuid())
  orderId    String
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  name       String
  category   String @default("")
  price      Float
  quantity   Int
  subtotal   Float
  portion    String @default("full") // full | half (half plate: half price, half the recipe)

  @@index([orderId])
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  phone     String     @default("")
  email     String     @default("")
  address   String     @default("")
  createdAt DateTime   @default(now())
  purchases Purchase[]
}

model StockItem {
  id           Int             @id @default(autoincrement())
  name         String          @unique
  unit         String // base unit everything is counted in: kg, pcs, L …
  packUnit     String? // optional bulk unit it is bought in, e.g. "pack", "box"
  unitsPerPack Float? // base units in one pack, e.g. 20 cigarettes per pack
  quantity     Float           @default(0)
  reorderLevel Float           @default(0)
  costPerUnit  Float           @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]
  recipes      RecipeItem[]
  purchases    PurchaseItem[]
}

model StockMovement {
  id          String    @id @default(uuid())
  stockItemId Int
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  change      Float
  reason      String // purchase | sale | cancel | adjustment | wastage | purchase_void
  note        String    @default("")
  refId       String?
  createdAt   DateTime  @default(now())

  @@index([stockItemId, createdAt])
}

model Purchase {
  id            String         @id @default(uuid())
  supplierId    String?
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceNo     String         @default("")
  date          DateTime       @default(now())
  notes         String         @default("")
  paymentStatus String         @default("paid") // paid | unpaid
  totalAmount   Float
  createdAt     DateTime       @default(now())
  items         PurchaseItem[]

  @@index([date])
}

model PurchaseItem {
  id          String    @id @default(uuid())
  purchaseId  String
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  stockItemId Int
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity    Float
  unitCost    Float
  subtotal    Float
}
