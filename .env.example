# Copy this file to .env (same folder) and adjust values.
# One file is shared by docker compose, the API (server/), Prisma and Vite.
# Only variables prefixed with VITE_ are exposed to the browser — never put secrets in them.

# ---------- Database (docker compose) ----------
POSTGRES_USER=afos
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=afos
# Host port for Postgres. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

# ---------- API ----------
# Used when running the API or Prisma commands on your machine (outside Docker).
# Inside Docker the API builds its own URL from the POSTGRES_* values above.
DATABASE_URL=postgresql://afos:change-me-db-password@localhost:5433/afos
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
API_PORT=3001
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# debug | info | warn | error
LOG_LEVEL=info

# Passwords for the admin, chef and cashier accounts created by the seed (only used the first time).
SEED_ADMIN_PASSWORD=admin123
SEED_CHEF_PASSWORD=chef123
SEED_CASHIER_PASSWORD=cashier123

# Days of daily database backups to keep in ./backups
BACKUP_RETENTION_DAYS=14

# ---------- Online payments (guests pay their bill from the order page) ----------
# Money goes to the MERCHANT account that owns these keys, not to a wallet number typed here.
# Register each wallet below as a merchant with eSewa / Khalti to get live keys.
# If a key contains "$", write it as "$$" (docker compose reads "$" as a variable).
#
# test = sandbox, no real money. live = real payments (needs your merchant keys).
ESEWA_ENV=test
# Leave both empty in test mode to use eSewa's public sandbox merchant (EPAYTEST).
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# Shown to guests as the account they are paying
ESEWA_ACCOUNT=9840040733

KHALTI_ENV=test
# From https://test-admin.khalti.com (test) or https://admin.khalti.com (live). Khalti stays off until this is set.
KHALTI_SECRET_KEY=
KHALTI_ACCOUNT=9866028826

# Address guests return to after paying. Leave empty to use the address they ordered from
# (e.g. http://192.168.1.25:5173). Set it when hosting online, e.g. https://order.yummyfoodland.com
PUBLIC_APP_URL=

# ---------- Frontend (exposed to the browser) ----------
# Leave empty in development (Vite proxies /api to the local API).
# In production set it to the public API origin, e.g. https://afos-api.onrender.com
VITE_API_URL=
